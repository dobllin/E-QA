# Salin file ini menjadi ".env" lalu ISI semua nilai. JANGAN commit file .env.

# Password database (buat yang panjang dan acak)
DB_PASSWORD=ganti-dengan-password-database-yang-kuat

# Kunci penanda login. WAJIB acak dan minimal 32 karakter.
# Cara membuat: openssl rand -base64 48     (atau: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=ganti-dengan-teks-acak-minimal-32-karakter-xxxxxxxxxxxx

# Akun Super Admin pertama (dibuat otomatis HANYA jika belum ada pengguna sama sekali).
# Setelah login pertama, segera ganti password lewat menu Pengguna.
BOOTSTRAP_ADMIN_USERNAME=superadmin
BOOTSTRAP_ADMIN_PASSWORD=ganti-password-awal-ini-123

# Alamat yang dipakai BROWSER untuk membuka web dan API.
# Di laptop sendiri biarkan localhost. Kalau diakses dari HP/komputer lain di jaringan yang sama,
# ganti dengan IP komputer server, misal 192.168.1.20.
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# Isi true HANYA untuk mencoba dengan data demo (docker compose exec api node dist/seed.js).
ALLOW_DEMO_SEED=false

# Opsional
MAX_PIN_ATTEMPTS=3
POS_RATE_LIMIT=600

# Cadangan database otomatis (layanan 'backup' di docker-compose): berapa jam sekali dan berapa hari disimpan.
BACKUP_EVERY_HOURS=24
BACKUP_KEEP_DAYS=14
